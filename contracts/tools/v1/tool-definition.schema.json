{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthghost:contracts:tools:v1.0:tool-definition",
  "title": "Tool Definition v1.0",
  "description": "Policy-relevant metadata for a capability exposed as a tool.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "name", "description", "effect", "risk_level", "required_context", "required_roles", "confirmation_policy", "audit_level", "arguments_schema"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "effect": { "enum": ["informational", "external_read", "external_write", "physical_action"] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "required_context": { "enum": ["none", "active_session", "explicit_user_request", "administrator_action"] },
    "required_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["administrator", "household_member", "guest"] }
    },
    "confirmation_policy": { "enum": ["none", "contextual", "explicit"] },
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
      }
    },
    "allowed_devices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      }
    },
    "audit_level": { "enum": ["none", "metadata", "security"] },
    "arguments_schema": {
      "type": "object",
      "description": "A JSON Schema fragment for tool arguments. It must not contain secret defaults."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "effect": { "const": "physical_action" } },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "confirmation_policy": { "enum": ["contextual", "explicit"] },
          "audit_level": { "enum": ["metadata", "security"] }
        }
      }
    },
    {
      "if": {
        "properties": { "risk_level": { "const": "critical" } },
        "required": ["risk_level"]
      },
      "then": {
        "properties": {
          "confirmation_policy": { "const": "explicit" },
          "audit_level": { "const": "security" }
        }
      }
    }
  ]
}
