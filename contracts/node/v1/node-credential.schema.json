{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthghost:contracts:node:v1.0:node-credential",
  "title": "Node Credential v1.0",
  "description": "Technology-neutral public credential lifecycle metadata; private key and bearer secret material are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "credential_id", "node_id", "credential_type", "issued_at", "status"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "credential_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "credential_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "replacement_credential_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "status": { "enum": ["active", "revoked", "expired", "replaced"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "active" } },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["revoked_at"] },
            { "required": ["replacement_credential_id"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "revoked" } },
        "required": ["status"]
      },
      "then": {
        "required": ["revoked_at"],
        "not": { "required": ["replacement_credential_id"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "expired" } },
        "required": ["status"]
      },
      "then": {
        "required": ["expires_at"],
        "not": {
          "anyOf": [
            { "required": ["revoked_at"] },
            { "required": ["replacement_credential_id"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "replaced" } },
        "required": ["status"]
      },
      "then": {
        "required": ["replacement_credential_id"],
        "not": { "required": ["revoked_at"] }
      }
    }
  ]
}
