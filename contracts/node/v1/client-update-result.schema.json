{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthghost:contracts:node:v1.0:client-update-result",
  "title": "Client Update Result v1.0",
  "description": "A capability-gated update manifest or file header. Accepted authorizes only the exact release/file bytes named by this result over the current mTLS session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "message_type", "request_id", "node_session_id", "outcome", "reason_code"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "message_type": { "const": "client.update.result" },
    "request_id": { "type": "string", "format": "uuid" },
    "node_session_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "outcome": { "enum": ["accepted", "denied"] },
    "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "available": { "type": "boolean" },
    "release_id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240 },
    "size": { "type": "integer", "minimum": 0, "maximum": 134217728 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "size": { "type": "integer", "minimum": 0, "maximum": 134217728 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
