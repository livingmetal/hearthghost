{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthghost:contracts:todo:v1.0:todo-record",
  "title": "Todo Record v1.0",
  "description": "Scoped explicit todo record. Creation and mutation require an already resolved personal-data principal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "todo_id", "scope", "scope_id", "text", "state", "created_at"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "todo_id": { "type": "string", "format": "uuid" },
    "scope": { "enum": ["user", "household"] },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "state": { "enum": ["open", "completed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "open" } }, "required": ["state"] },
      "then": { "not": { "required": ["completed_at"] } }
    },
    {
      "if": { "properties": { "state": { "const": "completed" } }, "required": ["state"] },
      "then": { "required": ["completed_at"] }
    }
  ]
}
