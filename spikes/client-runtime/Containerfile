FROM node:22-bookworm-slim AS dependencies

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM dependencies AS validation

COPY tsconfig.json vite.*.config.js ./
COPY runtime-import.mjs ./
COPY src ./src

RUN npm run check
RUN npm run build:vrm
RUN npm run build:pixi

CMD ["sh", "-c", "du -sk node_modules dist/vrm dist/pixi && find dist -type f -maxdepth 2 -printf '%p %s bytes\\n' | sort"]
